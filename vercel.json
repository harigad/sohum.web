{
  "redirects": [
    {
      "source": "/tribe.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tribe",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/founding",
      "destination": "/founding.html"
    },
    {
      "source": "/studio",
      "destination": "/studio.html"
    },
    {
      "source": "/founding/:member",
      "destination": "/api/founding-page?member=:member"
    }
  ],
  "functions": {
    "api/founding-page.js": {
      "includeFiles": "founding.html"
    }
  }
}
